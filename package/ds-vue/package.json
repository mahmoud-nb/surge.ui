{
  "name": "@surgeui/ds-vue",
  "version": "3.3.0",
  "description": "Former name of @surgeui/vue, kept as a deprecated relay: install @surgeui/vue instead.",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./style.layer.css": "./dist/style.layer.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "types.d.ts",
    "global.d.ts"
  ],
  "author": {
    "name": "Mahmoud NBET",
    "email": "mahmoud.nb@gmail.com"
  },
  "homepage": "https://surgeui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmoud-nb/surge.ui.git",
    "directory": "package/ds-vue"
  },
  "keywords": [
    "Vue",
    "Vue3",
    "Design System",
    "deprecated"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/copy-css.js"
  },
  "dependencies": {
    "@surgeui/vue": "3.3.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
